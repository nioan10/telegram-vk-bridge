# Секреты: заполните только в .env. Никогда не публикуйте его в Git.
TELEGRAM_BOT_TOKEN=
VK_ACCESS_TOKEN=

# Получите через discover-telegram / discover-vk.
TELEGRAM_CHAT_ID=
VK_PEER_ID=

# Личная отправка: только сообщения вашего аккаунта, без хештега.
# Получите числовой ID через discover-owner (username сюда не подходит).
PRIVATE_INBOX_ENABLED=true
TELEGRAM_OWNER_ID=

# Начальный хештег. После первого запуска меняйте его в личке бота: /tag #срочно.
# Совпадение полного хештега без учёта регистра, в тексте или подписи.
HASHTAG=#важно
STRIP_HASHTAG=false
INCLUDE_AUTHOR=true
ALBUM_WAIT_SECONDS=5
VK_API_VERSION=5.199

# В Docker оставьте state: сюда подключён постоянный том очереди.
DATA_DIR=state
